<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <FlbxStudioVersion>0.9.0-beta</FlbxStudioVersion>
    <FlbxStudioAssemblyVersion>0.9.0.0</FlbxStudioAssemblyVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>wpfui-icon.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>$(FlbxStudioVersion)</Version>
    <AssemblyVersion>$(FlbxStudioAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(FlbxStudioAssemblyVersion)</FileVersion>
    <InformationalVersion>$(FlbxStudioVersion)</InformationalVersion>
    <PackageVersion>$(FlbxStudioVersion)</PackageVersion>
    <PackageId>FlbxStudio</PackageId>
    <Authors>Screaminlean</Authors>
    <Company>Screaminlean</Company>
    <Product>FlbxStudio</Product>
    <Description>WPF desktop tool for opening, inspecting, and editing Weintek FLBX picture library files.</Description>
    <RepositoryUrl>https://github.com/Screaminlean/FlbxStudio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>flbx;wpf;hmi;weintek</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="wpfui-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\wpfui-icon-256.png" />
    <None Remove="Assets\wpfui-icon-1024.png" />
    <None Remove="Resources\Localization\en.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\wpfui-icon-256.png" />
    <Resource Include="Assets\wpfui-icon-1024.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
