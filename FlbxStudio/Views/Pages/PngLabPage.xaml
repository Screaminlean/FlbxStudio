<Page x:Class="FlbxStudio.Views.Pages.PngLabPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:FlbxStudio.Views.Pages" 
        xmlns:helpers="clr-namespace:FlbxStudio.Helpers"
        xmlns:converters="clr-namespace:FlbxStudio.Converters"
        xmlns:loc="clr-namespace:FlbxStudio.Extensions"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
        Title="PNG Lab" 
        d:DataContext="{d:DesignInstance local:PngLabPage, IsDesignTimeCreatable=False}" 
        d:DesignHeight="450" d:DesignWidth="800" 
        ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}" 
        ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
        mc:Ignorable="d"
        ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Margin="0,0,8,0" Icon="{ui:SymbolIcon FolderOpen24}" Content="Open PNG" Command="{Binding ViewModel.OpenPngCommand, Mode=OneWay}"/>
                <ui:Button Grid.Column="1" Margin="0,0,8,0" Icon="{ui:SymbolIcon Save24}" Content="Save PNG" Appearance="Primary" Command="{Binding ViewModel.SavePngCommand, Mode=OneWay}"/>

                <ui:TextBox Grid.Column="2" Margin="0,0,8,0" Width="80" PlaceholderText="Width" Text="{Binding ViewModel.NewImageWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ui:TextBox Grid.Column="3" Margin="0,0,8,0" Width="80" PlaceholderText="Height" Text="{Binding ViewModel.NewImageHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ui:Button Grid.Column="4" Margin="0,0,8,0" Icon="{ui:SymbolIcon Add24}" Content="New" Command="{Binding ViewModel.CreateNewPngCommand, Mode=OneWay}"/>

                <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="8,0,8,0" Text="{Binding ViewModel.DocumentTitle, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,10,0,10" Padding="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Selected" />
                <ui:TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding ViewModel.SelectedColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Click image to pick a color"/>
                <Border Grid.Column="2" Width="30" Height="30" Margin="0,0,16,0" CornerRadius="4" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{Binding ViewModel.SelectedColorBrush, Mode=OneWay}"/>

                <TextBlock Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center" Text="Replace with" />
                <ui:TextBox Grid.Column="4" Margin="0,0,8,0" Text="{Binding ViewModel.ReplacementColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Border Grid.Column="5" Width="30" Height="30" Margin="0,0,16,0" CornerRadius="4" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{Binding ViewModel.ReplacementColorBrush, Mode=OneWay}"/>

                <ui:Button Grid.Column="6" HorizontalAlignment="Left" Margin="0,0,12,0" Icon="{ui:SymbolIcon ArrowSwap24}" Content="Apply Replace" Command="{Binding ViewModel.ApplyColorSwapCommand, Mode=OneWay}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,10" Padding="12" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Content="Pick" Command="{Binding ViewModel.SetToolCommand, Mode=OneWay}" CommandParameter="pick"/>
                <ui:Button Margin="0,0,8,0" Content="Brush" Command="{Binding ViewModel.SetToolCommand, Mode=OneWay}" CommandParameter="brush"/>
                <ui:Button Margin="0,0,8,0" Content="Eraser" Command="{Binding ViewModel.SetToolCommand, Mode=OneWay}" CommandParameter="eraser"/>
                <TextBlock VerticalAlignment="Center" Margin="4,0,8,0" Text="Size" />
                <ui:NumberBox Width="auto"
                              Value="{Binding ViewModel.BrushSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Minimum="1"
                              Maximum="10"
                              SmallChange="1"
                              SpinButtonPlacementMode="Inline" />
                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.ActiveToolName, StringFormat=Tool: {0}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Image x:Name="PreviewImageControl"
                           Source="{Binding ViewModel.PreviewImage, Mode=OneWay}"
                           Visibility="{Binding ViewModel.HasPreviewImage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           MouseLeftButtonDown="PreviewImageControl_OnMouseLeftButtonDown"
                           MouseMove="PreviewImageControl_OnMouseMove"
                           MouseLeftButtonUp="PreviewImageControl_OnMouseLeftButtonUp"
                           MouseLeave="PreviewImageControl_OnMouseLeave" />

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ViewModel.HasPreviewImage, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="Image24" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Open a PNG or create a new canvas to begin editing." Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="4" Margin="4,10,4,0" Text="{Binding ViewModel.StatusMessage, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
